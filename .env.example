# solctx runs with NO API keys by default.

# Optional: override the Solana devnet RPC endpoint (defaults to public devnet).
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional: enable semantic search in get_docs. When set, `pnpm build:index`
# embeds the corpus and get_docs ranks by embedding similarity instead of BM25.
# Get a key at https://openrouter.ai (the default model below is free-tier).
# OPENROUTER_API_KEY=sk-or-your-key-here
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
